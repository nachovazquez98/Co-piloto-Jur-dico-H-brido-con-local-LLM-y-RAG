# Copia este archivo a .env para cambiar los valores por defecto (también se pueden cambiar desde la app).

# --- LLM ---
# Proveedor: "ollama" (local) u "openai" (cualquier API compatible con OpenAI: OpenAI, Groq, OpenRouter,
# LM Studio, vLLM, llama.cpp server...)
COPILOTO_LLM_PROVIDER=ollama
COPILOTO_LLM_MODEL=llama3.1:8b
COPILOTO_LLM_BASE_URL=http://localhost:11434
# COPILOTO_LLM_API_KEY=sk-...
COPILOTO_LLM_TEMPERATURE=0.0
COPILOTO_LLM_MAX_TOKENS=1024
COPILOTO_LLM_NUM_CTX=8192

# Ejemplos de otros proveedores:
# COPILOTO_LLM_PROVIDER=openai
# COPILOTO_LLM_BASE_URL=https://api.openai.com/v1      # OpenAI
# COPILOTO_LLM_BASE_URL=http://localhost:1234/v1       # LM Studio
# COPILOTO_LLM_BASE_URL=http://localhost:8000/v1       # vLLM / llama.cpp server
# COPILOTO_LLM_MODEL=gpt-4o-mini

# --- RAG ---
COPILOTO_NUM_PRECEDENTES=3
COPILOTO_MAX_POR_TIPO=30
