# Copia este archivo a .env para cambiar los valores por defecto (también se pueden cambiar desde la app).

# --- LLM ---
# Proveedor: "ollama" (local) u "openai" (cualquier API compatible con OpenAI: OpenAI, Groq, OpenRouter,
# LM Studio, vLLM, llama.cpp server...)
COPILOTO_LLM_PROVIDER=ollama
COPILOTO_LLM_MODEL=llama3.1:8b
COPILOTO_LLM_BASE_URL=http://localhost:11434
# COPILOTO_LLM_API_KEY=sk-...
COPILOTO_LLM_TEMPERATURE=0.0
COPILOTO_LLM_MAX_TOKENS=1024
COPILOTO_LLM_NUM_CTX=8192

# Ejemplos de otros proveedores:
# COPILOTO_LLM_PROVIDER=openai
# COPILOTO_LLM_BASE_URL=https://api.openai.com/v1      # OpenAI
# COPILOTO_LLM_BASE_URL=http://localhost:1234/v1       # LM Studio
# COPILOTO_LLM_BASE_URL=http://localhost:8000/v1       # vLLM / llama.cpp server
# COPILOTO_LLM_MODEL=gpt-4o-mini

# --- RAG ---
COPILOTO_NUM_PRECEDENTES=3
COPILOTO_MAX_POR_TIPO=30
COPILOTO_LLM_SEED=42

# --- v11: cada cambio es configurable; los valores de abajo (comentados) reproducen v10 ---
# Alcance: solo penal, y clasificar por familia de delito en lugar de por tipo
# COPILOTO_MATERIAS=penal
# COPILOTO_NIVEL_CLASIFICACION=familia         # tipo | familia
# Clasificador
# COPILOTO_USAR_LISTA_TOKENS_PENALIZADOS=true  # penaliza 'violacion', 'falsedad', ... (decidir con la ablación)
# COPILOTO_KEM_MODO=conceptos                  # conceptos | vocabulario (data/vocabulario/terminos_juridicos.txt)
# COPILOTO_RRF_K=60
# Prompts y controles
# COPILOTO_PROMPT_CONCEPTOS=v10                # v11 pide primero el delito y luego el problema procesal
# COPILOTO_PROMPT_PENAL=v10                    # v11 añade acto impugnado, agravios y sentido del fallo cerrado
# COPILOTO_QC1_CONTEXTO=inicio                 # inicio | fragmento_similar
# Aviso "sin precedentes del mismo tipo" por umbral (por medir con `evaluacion recuperacion`)
# COPILOTO_UMBRAL_SIN_PRECEDENTES=
# COPILOTO_SENAL_SIN_PRECEDENTES=kem_max       # score_hibrido | coseno | kem_max
